{
  "manifest_version": 3,
  "name": "Image Cloaker Pro",
  "version": "1.0",
  "description": "Protects images from AI scraping before upload.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Cloaker Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}